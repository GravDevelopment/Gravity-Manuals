# Production build settings for the GitHub Pages site.
#
# Dedicated Function App for this portal (resource group gravity-manuals-rg).
REACT_APP_API_BASE_URL=https://gravity-manuals-api.azurewebsites.net

# The key is NOT stored here — it would be permanent in git history on a public
# repo. It lives in .env.production.local (gitignored) and is baked into the
# bundle at build time. Recover it with:
#   az functionapp keys list -g gravity-manuals-rg -n gravity-manuals-api #     --query functionKeys.default -o tsv
#
# This app hosts only /api/trainings and /api/manual, so the key's reach is the
# trainings lookup. It cannot touch the kiosk's /api/sign.
REACT_APP_API_FUNCTION_KEY=
