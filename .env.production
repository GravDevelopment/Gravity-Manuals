# Production build settings for the GitHub Pages site.
#
# API lives on the kiosk Function App (see README "Deploy").
REACT_APP_API_BASE_URL=https://gravity-learner-kios-g5ghdwfwe4gkbxgm.southafricanorth-01.azurewebsites.net

# Deliberately EMPTY. /api/trainings is authLevel "function", so it needs a key —
# but this value is baked into the JS bundle and the bundle is public on Pages.
# The app's HOST key must never go here: it also authorises /api/sign, which
# writes attendance signatures into Dataverse. Once /api/trainings is deployed,
# mint a key scoped to that one function and put it here, then redeploy:
#   az functionapp keys set -g learner-kiosk-rg -n gravity-learner-kios \
#     --key-type functionKeys --key-name portal --function-name trainings
REACT_APP_API_FUNCTION_KEY=
