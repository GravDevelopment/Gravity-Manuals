# Local development points at the Azure Functions runtime (cd api && npm start).
# For production builds, override these (e.g. in a .env.production.local or CI):
#   REACT_APP_API_BASE_URL=https://<your-function-app>.azurewebsites.net
#   REACT_APP_API_FUNCTION_KEY=<function key>
REACT_APP_API_BASE_URL=http://localhost:7071
REACT_APP_API_FUNCTION_KEY=
BROWSER=none
